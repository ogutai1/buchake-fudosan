{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "buchake-fudosan",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // www なし → www 付きの転送を Worker でやるため、静的ページより先に Worker を通す
    "run_worker_first": true
  },
  "observability": { "enabled": true }
  // 独自ドメイン（www.bucchake-fudosan.com / bucchake-fudosan.com）は Cloudflare のゾーンで Worker に割り当てる
}
